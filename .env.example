# Redis
REDIS_URL=redis://localhost:6379/0

# Downloads
DOWNLOAD_DIR=./backend/downloads
FILE_TTL_SECONDS=3600
CLEANUP_INTERVAL_SECONDS=300

# Concurrency & Timeouts
MAX_CONCURRENT_DOWNLOADS=3
RESOLVE_TIMEOUT_SECONDS=30
DOWNLOAD_TIMEOUT_SECONDS=600

# Rate Limiting
RATE_LIMIT_RESOLVE=10/minute
RATE_LIMIT_DOWNLOAD=5/minute

# Authentication mode: "cookies" (default) | "browser" (local dev only)
AUTH_MODE=cookies

# Cookie file (auto-refreshed by ./refresh_cookies.sh)
COOKIES_FILE=./cookies.txt

# Auto-read from local browser (used when AUTH_MODE=browser, local dev only)
# COOKIES_FROM_BROWSER=edge

# Worker Retry
WORKER_MAX_RETRIES=3
WORKER_RETRY_DELAY_SECONDS=5
